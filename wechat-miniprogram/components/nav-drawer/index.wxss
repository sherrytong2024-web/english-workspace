.nav-root {
  min-height: 100vh;
  background: #f1f5f9;
}
.topbar {
  background: #1e293b;
  color: #fff;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}
.topbar-inner {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}
.menu-btn {
  width: 64rpx;
  font-size: 44rpx;
  color: #fff;
}
.topbar-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}
.topbar-spacer {
  width: 64rpx;
}
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 200;
}
.drawer {
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  width: 560rpx;
  background: #1e293b;
  color: #cbd5e1;
  z-index: 300;
  transform: translateX(-100%);
  transition: transform 0.25s ease;
  overflow-y: auto;
  box-sizing: border-box;
}
.drawer.open {
  transform: translateX(0);
}
.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #334155;
  color: #fff;
}
.drawer-logo {
  font-size: 32rpx;
  font-weight: 700;
}
.drawer-close {
  font-size: 32rpx;
  color: #94a3b8;
  padding: 10rpx;
}
.drawer-section {
  font-size: 22rpx;
  color: #64748b;
  padding: 24rpx 24rpx 10rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}
.drawer-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  font-size: 30rpx;
  border-bottom: 1rpx solid #2a3749;
}
.drawer-item.active {
  background: #334155;
  color: #fff;
}
.di-icon {
  width: 56rpx;
  font-size: 34rpx;
}
.content {
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}
