/* ===== 基础 ===== */
page {
  background: #f1f5f9;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #1e293b;
  font-size: 28rpx;
  line-height: 1.5;
}

/* ===== 卡片 ===== */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-weight: 700;
  font-size: 32rpx;
  margin-bottom: 18rpx;
  display: block;
}

.card-title-text {
  display: block;
  margin-bottom: 12rpx;
  font-weight: 700;
  font-size: 32rpx;
}

/* ===== 页头（竖排） ===== */
.page-header {
  margin-bottom: 28rpx;
}
.ph-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 8rpx;
  display: block;
}
.sub {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 16rpx;
  display: block;
}
.ph-actions {
  display: block;
}
.ph-actions button {
  display: inline-block;
  margin-right: 12rpx;
  margin-bottom: 10rpx;
}

/* ===== 按钮 ===== */
.btn {
  display: inline-block;
  padding: 12rpx 24rpx;
  border-radius: 10rpx;
  background: #3b82f6;
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.4;
  text-align: center;
  border: none;
}
.btn::after { border: none; }
.btn.ghost { background: #eef2ff; color: #3b82f6; }
.btn.outline { background: #fff; color: #3b82f6; border: 2rpx solid #3b82f6; }
.btn.danger { background: #ef4444; color: #fff; }
.btn.sm { font-size: 22rpx; padding: 8rpx 18rpx; }

/* ===== 标签 ===== */
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
  background: #e2e8f0;
  color: #475569;
}
.tag.fin { background: #dbeafe; color: #1e40af; }
.tag.pro { background: #ede9fe; color: #5b21b6; }
.tag.daily { background: #dcfce7; color: #166534; }
.tag.travel { background: #fef3c7; color: #92400e; }
.tag.biz { background: #fce7f3; color: #831843; }

.badge {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  background: #dcfce7;
  color: #166534;
  margin-left: 8rpx;
  font-weight: 600;
}
.badge.new { background: #3b82f6; color: #fff; }

/* ===== 分类筛选 ===== */
.filter-bar {
  margin-bottom: 20rpx;
}
.filter-chip {
  display: inline-block;
  padding: 10rpx 22rpx;
  border-radius: 22rpx;
  font-size: 26rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
  border: 1rpx solid #e2e8f0;
  background: #fff;
  color: #475569;
}
.filter-chip.active {
  background: #3b82f6;
  color: #fff;
  border-color: #3b82f6;
}

/* ===== 统计盒子 ===== */
.stat-box {
  background: #fff;
  border-radius: 14rpx;
  padding: 22rpx 14rpx;
  text-align: center;
  border: 1rpx solid #f1f5f9;
  display: block;
}
.stat-box .label { font-size: 24rpx; color: #64748b; font-weight: 500; display: block; }
.stat-box .value { font-size: 48rpx; font-weight: 800; color: #0f172a; margin: 10rpx 0 4rpx; display: block; }
.stat-box .delta { font-size: 22rpx; color: #94a3b8; display: block; }

/* ===== 表格 ===== */
table {
  width: 100%;
  font-size: 26rpx;
  border-collapse: collapse;
}
th {
  font-weight: 600;
  font-size: 24rpx;
  color: #64748b;
  padding: 12rpx 8rpx;
  background: #f8fafc;
  text-align: left;
}
td {
  padding: 14rpx 8rpx;
  border-bottom: 1rpx solid #f1f5f9;
  vertical-align: top;
}

/* ===== 进度条 ===== */
.progress-bar {
  height: 12rpx;
  background: #e2e8f0;
  border-radius: 6rpx;
  margin: 16rpx 0;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: #3b82f6;
}

/* ===== 网格（flex box） ===== */
.grid {
  display: flex;
  flex-wrap: wrap;
}
.grid-half {
  width: 50%;
  padding-right: 8rpx;
  box-sizing: border-box;
}
.grid-half-right {
  width: 50%;
  padding-left: 8rpx;
  box-sizing: border-box;
  margin-bottom: 14rpx;
}

/* ===== 对话 ===== */
.dialog-item {
  background: #f8fafc;
  border-radius: 14rpx;
  padding: 18rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #f1f5f9;
  display: block;
}
.dialog-meta {
  margin-bottom: 10rpx;
  font-size: 24rpx;
}
.dialog-meta-tag {
  display: inline-block;
  margin-right: 8rpx;
  margin-bottom: 6rpx;
}
.dialog-meta-title {
  font-weight: 600;
  font-size: 28rpx;
  color: #0f172a;
  display: block;
  margin-top: 6rpx;
}
.dialog-body {
  background: #f0f9ff;
  border-radius: 10rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
  border-left: 4rpx solid #3b82f6;
}
.dialog-line {
  padding: 8rpx 0;
  font-size: 26rpx;
  line-height: 1.6;
  border-bottom: 1rpx dashed #e0f2fe;
  display: block;
}
.dialog-line-last {
  padding: 8rpx 0;
  font-size: 26rpx;
  line-height: 1.6;
  display: block;
}
.dialog-speaker {
  font-weight: 700;
  color: #3b82f6;
  margin-right: 10rpx;
  font-size: 24rpx;
}
.dialog-actions {
  margin-top: 12rpx;
}
.dialog-actions button {
  display: inline-block;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}
.dialog-keywords {
  margin-bottom: 10rpx;
}
.dialog-keywords .tag {
  margin-right: 6rpx;
  margin-bottom: 6rpx;
}

/* ===== 资源 ===== */
.resource-card {
  border: 1rpx solid #f1f5f9;
  border-radius: 14rpx;
  padding: 20rpx;
  margin-bottom: 14rpx;
  background: #fff;
  display: block;
}
.resource-card .src { font-size: 22rpx; color: #94a3b8; display: block; }
.resource-card .name { font-weight: 700; font-size: 28rpx; margin: 8rpx 0; color: #0f172a; display: block; }
.resource-card .desc { font-size: 24rpx; color: #64748b; margin-bottom: 12rpx; line-height: 1.5; display: block; }
.resource-card .link { font-size: 24rpx; color: #3b82f6; font-weight: 600; }

.res-cat-header {
  font-weight: 700;
  font-size: 30rpx;
  padding: 20rpx 0 14rpx;
  margin-bottom: 14rpx;
  border-bottom: 2rpx solid #e2e8f0;
  display: block;
}
.res-collapsed { display: none; }

/* ===== 复习闪卡 ===== */
.flash-card {
  background: linear-gradient(135deg, #eff6ff, #dbeafe);
  border-radius: 24rpx;
  padding: 60rpx 32rpx;
  margin-bottom: 24rpx;
  display: block;
}
.flash-card .category { font-size: 24rpx; margin-bottom: 16rpx; display: block; text-align: center; }
.flash-card .word { font-size: 56rpx; font-weight: 800; color: #0f172a; margin-bottom: 12rpx; text-align: center; display: block; }
.flash-card .phonetic { font-size: 28rpx; color: #64748b; margin-bottom: 12rpx; text-align: center; display: block; }
.flash-card .meaning { font-size: 36rpx; font-weight: 600; color: #1e40af; margin-bottom: 8rpx; text-align: center; display: block; }
.flash-card .example { font-size: 26rpx; color: #475569; font-style: italic; text-align: center; display: block; }
.review-bar { text-align: center; margin-bottom: 16rpx; }
.review-bar button { display: inline-block; margin: 0 8rpx; }

/* ===== 博客/歌曲 ===== */
.blog-card .src { font-size: 22rpx; color: #94a3b8; display: block; }
.blog-card .name { font-weight: 700; font-size: 30rpx; margin: 10rpx 0; color: #0f172a; line-height: 1.4; display: block; }
.blog-card .desc { font-size: 26rpx; color: #64748b; margin-bottom: 14rpx; line-height: 1.5; display: block; }
.blog-card .link { font-size: 26rpx; color: #3b82f6; font-weight: 600; }

.song-card { text-align: center; padding: 24rpx 20rpx; margin-bottom: 16rpx; background: #fff; border-radius: 16rpx; border: 1rpx solid #f1f5f9; display: block; }
.song-card .song-art { width: 180rpx; height: 180rpx; border-radius: 20rpx; margin: 0 auto; display: block; }
.song-card .song-art-placeholder { width: 180rpx; height: 180rpx; border-radius: 20rpx; background: #e0e7ff; line-height: 180rpx; font-size: 72rpx; margin: 0 auto; text-align: center; }
.song-card .song-play { margin-top: 16rpx; width: 100%; }
.song-card .song-no-preview { font-size: 22rpx; color: #94a3b8; margin-top: 12rpx; display: block; }
.song-card .song-actions { margin-top: 18rpx; text-align: center; }
.song-card .song-actions button { display: inline-block; margin: 0 6rpx; }
.song-card.liked { border: 2rpx solid #ef4444; }
.song-card.disliked { opacity: 0.5; }

/* ===== 学习概览日历 ===== */
.calendar-table { width: 100%; border-collapse: separate; border-spacing: 6rpx; }
.calendar-table th { text-align: center; padding: 8rpx 2rpx; font-size: 22rpx; color: #64748b; background: transparent; }
.calendar-table td { text-align: center; padding: 14rpx 0; border-radius: 8rpx; font-size: 28rpx; border: none; }

/* ===== 仪表盘 ===== */
.weekly-list { font-size: 26rpx; }
.weekly-list .item { padding: 14rpx 0; border-bottom: 1rpx solid #f1f5f9; display: block; }
.weekly-list .day { font-weight: 700; color: #3b82f6; margin-right: 16rpx; }
.recommend-preview { padding: 16rpx; background: #f8fafc; border-radius: 12rpx; border: 1rpx solid #e2e8f0; display: block; }
.recommend-preview .thumb { font-size: 48rpx; margin-right: 16rpx; }
.recommend-preview .title { font-weight: 600; font-size: 28rpx; color: #0f172a; }
.recommend-preview .meta { font-size: 22rpx; color: #64748b; margin-top: 4rpx; }

/* ===== 表单 ===== */
.form-label { font-size: 24rpx; color: #64748b; margin-bottom: 8rpx; font-weight: 500; display: block; }
.input, textarea, picker {
  display: block;
  width: 100%;
  padding: 14rpx 16rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #0f172a;
  background: #fff;
  box-sizing: border-box;
  margin-bottom: 14rpx;
}
textarea { min-height: 120rpx; }

/* ===== 杂项 ===== */
.muted { color: #64748b; }
.empty { color: #94a3b8; text-align: center; padding: 60rpx 0; font-size: 26rpx; display: block; }
.section-title { font-weight: 700; font-size: 32rpx; margin: 28rpx 0 18rpx; color: #0f172a; display: block; }
.scroll-x { overflow-x: auto; white-space: nowrap; -webkit-overflow-scrolling: touch; }


/* === 兼容旧 class 名（WXML 还在用） === */
.line { padding: 8rpx 0; font-size: 26rpx; line-height: 1.6; display: block; }
.speaker { font-weight: 700; color: #3b82f6; margin-right: 10rpx; font-size: 24rpx; }
.fill { height: 100%; background: #3b82f6; }
.form-row { margin-bottom: 16rpx; }
.title { font-weight: 600; font-size: 28rpx; color: #0f172a; }


/* === 日历（flex grid 替代 table） === */
.cal-week { display: flex; margin-bottom: 8rpx; }
.cal-cell { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 10rpx; font-size: 28rpx; margin: 0 3rpx; }
.cal-weekday { font-size: 24rpx; color: #64748b; padding: 8rpx 0; }
.cal-day { background: #f9fafb; border: 1rpx solid #e2e8f0; }


/* === log 4格统计 2x2 === */
.log-stats { display: flex; flex-wrap: wrap; justify-content: space-between; margin-bottom: 20rpx; }
.log-stat { width: 48%; margin-bottom: 14rpx; box-sizing: border-box; }


/* === 今日单词卡片 === */
.dw-group-sep { text-align: center; color: #64748b; font-size: 22rpx; padding: 12rpx 0; }
.dw-card { display: flex; align-items: flex-start; padding: 16rpx 12rpx; border-bottom: 1rpx solid #f1f5f9; }
.dw-card:last-of-type { border-bottom: none; }
.dw-check { width: 44rpx; height: 44rpx; border: 2rpx solid #cbd5e1; border-radius: 50%; margin-right: 16rpx; margin-top: 6rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: #fff; box-sizing: border-box; }
.dw-checked { background: #10b981; border-color: #10b981; }
.dw-body { flex: 1; min-width: 0; }
.dw-head { display: flex; align-items: center; gap: 10rpx; margin-bottom: 4rpx; }
.dw-word { font-weight: 700; font-size: 32rpx; color: #0f172a; }
.dw-phonetic { display: block; font-size: 22rpx; color: #64748b; margin-bottom: 4rpx; }
.dw-meaning { display: block; font-size: 28rpx; color: #1e293b; margin-bottom: 4rpx; }
.dw-example { display: block; font-size: 24rpx; color: #94a3b8; line-height: 1.5; }


/* === 歌曲卡（带进度条） === */
.song-head { display: flex; align-items: center; gap: 16rpx; margin-bottom: 14rpx; }
.song-info { flex: 1; min-width: 0; }
.song-title { font-size: 30rpx; font-weight: 700; color: #0f172a; display: block; }
.song-artist { font-size: 24rpx; color: #64748b; margin-top: 4rpx; display: block; }
.song-play-btn { width: 80rpx; height: 80rpx; border-radius: 50%; background: #3b82f6; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 36rpx; }
.song-progress { display: flex; align-items: center; gap: 10rpx; margin: 14rpx 0; }
.song-time { font-size: 22rpx; color: #64748b; min-width: 60rpx; }
.song-bar-bg { flex: 1; height: 8rpx; background: #e2e8f0; border-radius: 4rpx; overflow: hidden; }
.song-bar-fg { height: 100%; background: #3b82f6; }
.song-slider { flex: 1; margin: 0; }
