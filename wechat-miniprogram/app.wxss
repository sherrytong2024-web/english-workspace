/* ===== 基础：WXML 最安全的 CSS 子集 ===== */
/* 规则：不用 gap、不用 :first-child、flex-wrap 仅必要时用、所有间隔用 margin/padding */

page {
  background: #f1f5f9;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #1e293b;
  font-size: 28rpx;
  line-height: 1.5;
}

/* ===== 卡片 ===== */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-weight: 700;
  font-size: 32rpx;
  margin-bottom: 18rpx;
}

.card-title > text,
.card-title > view > text:first-child {
  display: block;
  margin-bottom: 12rpx;
}

/* ===== 页头（竖排） ===== */
.page-header {
  margin-bottom: 28rpx;
}
.page-header .ph-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 8rpx;
  display: block;
}
.page-header .sub {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 16rpx;
  display: block;
}
.page-header .ph-actions {
  display: block;
}
.page-header .ph-actions > button {
  margin-right: 12rpx;
  margin-bottom: 10rpx;
  display: inline-block;
}

/* ===== 按钮 ===== */
.btn {
  display: inline-block;
  padding: 12rpx 24rpx;
  border-radius: 10rpx;
  background: #3b82f6;
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.4;
  text-align: center;
}
.btn::after { border: none; }
.btn.ghost { background: #eef2ff; color: #3b82f6; }
.btn.outline { background: #fff; color: #3b82f6; border: 2rpx solid #3b82f6; }
.btn.danger { background: #ef4444; color: #fff; }
.btn.sm { font-size: 22rpx; padding: 8rpx 18rpx; }

/* ===== 标签 ===== */
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
}
.tag.fin { background: #dbeafe; color: #1e40af; }
.tag.pro { background: #ede9fe; color: #5b21b6; }
.tag.daily { background: #dcfce7; color: #166534; }
.tag.travel { background: #fef3c7; color: #92400e; }
.tag.biz { background: #fce7f3; color: #831843; }

.badge {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  background: #dcfce7;
  color: #166534;
  margin-left: 8rpx;
  font-weight: 600;
}
.badge.new { background: #3b82f6; color: #fff; }

/* ===== 分类筛选 ===== */
.filter-bar {
  margin-bottom: 20rpx;
}
.filter-chip {
  display: inline-block;
  padding: 10rpx 22rpx;
  border-radius: 22rpx;
  font-size: 26rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
  border: 1rpx solid #e2e8f0;
  background: #fff;
  color: #475569;
}
.filter-chip.active {
  background: #3b82f6;
  color: #fff;
  border-color: #3b82f6;
}

/* ===== 统计盒子 ===== */
.stat-box {
  background: #fff;
  border-radius: 14rpx;
  padding: 22rpx 14rpx;
  text-align: center;
  border: 1rpx solid #f1f5f9;
}
.stat-box .label { font-size: 24rpx; color: #64748b; font-weight: 500; }
.stat-box .value { font-size: 48rpx; font-weight: 800; color: #0f172a; margin: 10rpx 0 4rpx; }
.stat-box .delta { font-size: 22rpx; color: #94a3b8; }

/* ===== 表格 ===== */
table {
  width: 100%;
  font-size: 26rpx;
}
th {
  font-weight: 600;
  font-size: 24rpx;
  color: #64748b;
  padding: 12rpx 8rpx;
  background: #f8fafc;
  text-align: left;
}
td {
  padding: 14rpx 8rpx;
  border-bottom: 1rpx solid #f1f5f9;
  vertical-align: top;
}

/* ===== 进度条 ===== */
.progress-bar {
  height: 12rpx;
  background: #e2e8f0;
  border-radius: 6rpx;
  margin: 16rpx 0;
  overflow: hidden;
}
.progress-bar .fill {
  height: 100%;
  background: #3b82f6;
}

/* ===== 网格 ===== */
.grid-2 { display: flex; flex-wrap: wrap; }
.grid-2 > * { width: calc(50% - 8rpx); margin-right: 8rpx; margin-bottom: 16rpx; }
.grid-2 > *:nth-child(2n) { margin-right: 0; }

.grid-4 { display: flex; flex-wrap: wrap; }
.grid-4 > * { width: calc(50% - 7rpx); margin-right: 7rpx; margin-bottom: 14rpx; }
.grid-4 > *:nth-child(2n) { margin-right: 0; }

/* ===== 对话 ===== */
.dialog-item {
  background: #f8fafc;
  border-radius: 14rpx;
  padding: 18rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #f1f5f9;
}
.dialog-meta {
  margin-bottom: 10rpx;
  font-size: 24rpx;
}
.dialog-meta > * {
  display: inline-block;
  margin-right: 8rpx;
  margin-bottom: 6rpx;
}
.dialog-meta .title {
  font-weight: 600;
  font-size: 28rpx;
  color: #0f172a;
  display: block;
  margin-top: 6rpx;
  margin-right: 0;
}
.dialog-body {
  background: #f0f9ff;
  border-radius: 10rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
  border-left: 4rpx solid #3b82f6;
}
.dialog-body .line {
  padding: 8rpx 0;
  font-size: 26rpx;
  line-height: 1.6;
  border-bottom: 1rpx dashed #e0f2fe;
}
.dialog-body .line:last-child { border-bottom: none; }
.dialog-body .speaker {
  font-weight: 700;
  color: #3b82f6;
  margin-right: 10rpx;
  font-size: 24rpx;
}
.dialog-actions {
  margin-top: 12rpx;
}
.dialog-actions > * {
  display: inline-block;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}
.dialog-keywords {
  margin-bottom: 10rpx;
}
.dialog-keywords > .tag {
  margin-right: 6rpx;
  margin-bottom: 6rpx;
}

/* ===== 资源 ===== */
.resource-card {
  border: 1rpx solid #f1f5f9;
  border-radius: 14rpx;
  padding: 20rpx;
  margin-bottom: 14rpx;
  background: #fff;
}
.resource-card .src { font-size: 22rpx; color: #94a3b8; }
.resource-card .name { font-weight: 700; font-size: 28rpx; margin: 8rpx 0; color: #0f172a; }
.resource-card .desc { font-size: 24rpx; color: #64748b; margin-bottom: 12rpx; line-height: 1.5; }
.resource-card .link { font-size: 24rpx; color: #3b82f6; font-weight: 600; }
.res-cat-header {
  font-weight: 700;
  font-size: 30rpx;
  padding: 20rpx 0 14rpx;
  margin-bottom: 14rpx;
  border-bottom: 2rpx solid #e2e8f0;
}
.res-collapsed { display: none; }

/* ===== 复习闪卡 ===== */
.flash-card {
  background: linear-gradient(135deg, #eff6ff, #dbeafe);
  border-radius: 24rpx;
  padding: 60rpx 32rpx;
  margin-bottom: 24rpx;
}
.flash-card .category { font-size: 24rpx; margin-bottom: 16rpx; }
.flash-card .word { font-size: 56rpx; font-weight: 800; color: #0f172a; margin-bottom: 12rpx; text-align: center; }
.flash-card .phonetic { font-size: 28rpx; color: #64748b; margin-bottom: 12rpx; text-align: center; }
.flash-card .meaning { font-size: 36rpx; font-weight: 600; color: #1e40af; margin-bottom: 8rpx; text-align: center; }
.flash-card .example { font-size: 26rpx; color: #475569; font-style: italic; text-align: center; }
.review-bar { text-align: center; margin-bottom: 16rpx; }
.review-bar > button { display: inline-block; margin: 0 8rpx; }

/* ===== 博客/歌曲 ===== */
.blog-card { }
.blog-card .src { font-size: 22rpx; color: #94a3b8; }
.blog-card .name { font-weight: 700; font-size: 30rpx; margin: 10rpx 0; color: #0f172a; line-height: 1.4; }
.blog-card .desc { font-size: 26rpx; color: #64748b; margin-bottom: 14rpx; line-height: 1.5; }
.blog-card .link { font-size: 26rpx; color: #3b82f6; font-weight: 600; }

.song-card { text-align: center; padding: 24rpx 20rpx; margin-bottom: 16rpx; background: #fff; border-radius: 16rpx; border: 1rpx solid #f1f5f9; }
.song-card .song-art { width: 180rpx; height: 180rpx; border-radius: 20rpx; margin: 0 auto; display: block; }
.song-card .song-art-placeholder { width: 180rpx; height: 180rpx; border-radius: 20rpx; background: #e0e7ff; line-height: 180rpx; font-size: 72rpx; margin: 0 auto; text-align: center; }
.song-card .song-play { margin-top: 16rpx; width: 100%; }
.song-card .song-no-preview { font-size: 22rpx; color: #94a3b8; margin-top: 12rpx; }
.song-card .song-actions { margin-top: 18rpx; text-align: center; }
.song-card .song-actions > button { display: inline-block; margin: 0 6rpx; }
.song-card.liked { border: 2rpx solid #ef4444; }
.song-card.disliked { opacity: 0.5; }

/* ===== 学习概览日历 ===== */
.calendar-table { width: 100%; border-collapse: separate; border-spacing: 6rpx; }
.calendar-table th { text-align: center; padding: 8rpx 2rpx; font-size: 22rpx; color: #64748b; background: transparent; }
.calendar-table td { text-align: center; padding: 14rpx 0; border-radius: 8rpx; font-size: 28rpx; border: none; }

/* ===== 仪表盘 ===== */
.weekly-list { font-size: 26rpx; }
.weekly-list .item { padding: 14rpx 0; border-bottom: 1rpx solid #f1f5f9; }
.weekly-list .day { font-weight: 700; color: #3b82f6; margin-right: 16rpx; }
.recommend-preview { padding: 16rpx; background: #f8fafc; border-radius: 12rpx; border: 1rpx solid #e2e8f0; }
.recommend-preview .thumb { font-size: 48rpx; margin-right: 16rpx; }
.recommend-preview .title { font-weight: 600; font-size: 28rpx; color: #0f172a; }
.recommend-preview .meta { font-size: 22rpx; color: #64748b; margin-top: 4rpx; }

/* ===== 表单 ===== */
.form-label { font-size: 24rpx; color: #64748b; margin-bottom: 8rpx; font-weight: 500; }
.input, textarea, picker {
  display: block;
  width: 100%;
  padding: 14rpx 16rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #0f172a;
  background: #fff;
  box-sizing: border-box;
  margin-bottom: 14rpx;
}
textarea { min-height: 120rpx; }

/* ===== 杂项 ===== */
.muted { color: #64748b; }
.empty { color: #94a3b8; text-align: center; padding: 60rpx 0; font-size: 26rpx; }
.section-title { font-weight: 700; font-size: 32rpx; margin: 28rpx 0 18rpx; color: #0f172a; }
.scroll-x { overflow-x: auto; white-space: nowrap; -webkit-overflow-scrolling: touch; }
.log-stats > .stat-box { margin-bottom: 14rpx; }

/* ===== nav-drawer 内容区 ===== */
/* 确保 .content 里的所有内容块不会溢出 */
.nav-root .content {
  padding: 0 24rpx 40rpx 24rpx;
  box-sizing: border-box;
  width: 100%;
}
.nav-root .content > * {
  max-width: 100%;
  box-sizing: border-box;
}
