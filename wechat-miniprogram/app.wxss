page {
  background: #f1f5f9;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #1e293b;
  font-size: 28rpx;
}

/* ===== 布局卡片 ===== */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.card-title {
  font-weight: 600;
  font-size: 30rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}
.page-header > view:first-child {
  flex: 1;
  min-width: 0;
  word-break: break-all;
}
.page-header h2 { font-size: 40rpx; font-weight: 700; margin: 0; }
.sub { font-size: 24rpx; color: #64748b; margin-top: 4rpx; word-break: break-all; }

/* ===== 按钮 ===== */
.btn {
  display: inline-block;
  padding: 10rpx 24rpx;
  border-radius: 10rpx;
  background: #3b82f6;
  color: #fff;
  font-size: 26rpx;
  border: none;
  line-height: 1.4;
}
.btn::after { border: none; }
.btn.ghost { background: #eef2ff; color: #3b82f6; }
.btn.outline {
  background: #fff;
  color: #3b82f6;
  border: 1rpx solid #3b82f6;
}
.btn.danger { background: #ef4444; color: #fff; }
.btn.sm { font-size: 22rpx; padding: 8rpx 18rpx; }
.btn.active { background: #3b82f6; color: #fff; }

/* ===== 标签 ===== */
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background: #e2e8f0;
  color: #475569;
  margin-right: 8rpx;
}
.tag.fin { background: #dbeafe; color: #1e40af; }
.tag.pro { background: #ede9fe; color: #5b21b6; }
.tag.daily { background: #dcfce7; color: #166534; }
.tag.travel { background: #fef3c7; color: #92400e; }
.tag.biz { background: #fce7f3; color: #831843; }
.badge {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  background: #dcfce7;
  color: #166534;
  margin-left: 8rpx;
}
.badge.new { background: #3b82f6; color: #fff; }

/* ===== 分类筛选 ===== */
.filter-bar {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}
.filter-chip {
  display: inline-block;
  padding: 10rpx 22rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  background: #f1f5f9;
  color: #475569;
  border: 1rpx solid #e2e8f0;
}
.filter-chip.active {
  background: #3b82f6;
  color: #fff;
  border-color: #3b82f6;
}

/* ===== 统计盒子 ===== */
.stat-box {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04);
  text-align: center;
}
.stat-box .label { font-size: 22rpx; color: #64748b; margin-bottom: 8rpx; }
.stat-box .value { font-size: 44rpx; font-weight: 700; color: #1e293b; }
.stat-box .delta { font-size: 20rpx; color: #94a3b8; margin-top: 6rpx; }

/* ===== 表格 ===== */
table {
  width: 100%;
  border-collapse: collapse;
  font-size: 26rpx;
}
thead { background: #f8fafc; }
th, td {
  text-align: left;
  padding: 14rpx 12rpx;
  border-bottom: 1rpx solid #f1f5f9;
}
th {
  font-weight: 600;
  font-size: 24rpx;
  color: #64748b;
}

/* ===== 进度条 ===== */
.progress-bar {
  height: 12rpx;
  background: #e2e8f0;
  border-radius: 6rpx;
  overflow: hidden;
}
.progress-bar .fill {
  height: 100%;
  background: #3b82f6;
  transition: width 0.3s;
}

/* ===== 网格 ===== */
.grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; }
.grid-3 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14rpx; }
.grid-4 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-bottom: 20rpx;
}

/* ===== 对话 ===== */
.dialog-item {
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}
.dialog-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
  font-size: 24rpx;
}
.dialog-meta .title { font-weight: 600; font-size: 28rpx; }
.dialog-body {
  background: #f0f9ff;
  border-radius: 8rpx;
  padding: 14rpx;
  margin-bottom: 10rpx;
}
.dialog-body .line {
  padding: 6rpx 0;
  font-size: 26rpx;
  line-height: 1.6;
}
.dialog-body .speaker {
  font-weight: 600;
  color: #3b82f6;
  margin-right: 8rpx;
}
.dialog-actions {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
}
.dialog-keywords {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-bottom: 8rpx;
}
.dialog-keywords .tag { font-size: 20rpx; }

/* ===== 资源 ===== */
.resource-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  border: 1rpx solid #f1f5f9;
}
.resource-card .src { font-size: 22rpx; color: #94a3b8; margin-bottom: 6rpx; }
.resource-card .name { font-weight: 600; font-size: 28rpx; margin-bottom: 8rpx; }
.resource-card .desc { font-size: 24rpx; color: #64748b; margin-bottom: 12rpx; line-height: 1.5; }
.resource-card .link { font-size: 24rpx; color: #3b82f6; }
.res-cat-header {
  font-weight: 600;
  font-size: 30rpx;
  padding: 16rpx 0;
  margin-bottom: 12rpx;
  border-bottom: 1rpx solid #e2e8f0;
}
.res-collapsed { display: none; }

/* ===== 复习 ===== */
.flash-card {
  background: linear-gradient(135deg, #eff6ff, #fef3c7);
  border-radius: 20rpx;
  padding: 40rpx;
  text-align: center;
  min-height: 300rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  user-select: none;
}
.flash-card .category { font-size: 24rpx; }
.flash-card .word { font-size: 56rpx; font-weight: 700; color: #1e293b; }
.flash-card .phonetic { font-size: 28rpx; color: #64748b; }
.flash-card .meaning { font-size: 36rpx; font-weight: 600; color: #3b82f6; }
.flash-card .example { font-size: 28rpx; color: #64748b; }
.review-bar {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

/* ===== 博客 / 歌曲 ===== */
.blog-card { }
.blog-card .src { font-size: 22rpx; color: #94a3b8; }
.blog-card .name { font-weight: 600; font-size: 28rpx; margin: 8rpx 0; line-height: 1.4; }
.blog-card .desc {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.blog-card .link { font-size: 24rpx; color: #3b82f6; }

.song-card {
  text-align: center;
  padding: 20rpx;
}
.song-card .song-art {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  display: block;
  margin: 0 auto;
}
.song-card .song-art-placeholder {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin: 0 auto;
}
.song-card .song-play {
  width: 100%;
  margin-top: 12rpx;
}
.song-card .song-no-preview { font-size: 22rpx; color: #94a3b8; margin-top: 12rpx; }
.song-card .song-actions {
  display: flex;
  gap: 8rpx;
  justify-content: center;
  margin-top: 14rpx;
}
.song-card.liked { border: 2rpx solid #ef4444; }
.song-card.disliked { opacity: 0.5; }

/* ===== 学习概览 ===== */
.calendar-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 4rpx;
}
.calendar-table td {
  text-align: center;
  padding: 12rpx 4rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
}
.calendar-table th {
  text-align: center;
  padding: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  font-weight: 500;
}

/* ===== 仪表盘 ===== */
.weekly-list { font-size: 26rpx; }
.weekly-list .item {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}
.weekly-list .day { font-weight: 600; }
.recommend-preview {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx;
  background: #f8fafc;
  border-radius: 10rpx;
}
.recommend-preview .thumb { font-size: 40rpx; }
.recommend-preview .title { font-weight: 600; font-size: 28rpx; }
.recommend-preview .meta { font-size: 22rpx; color: #64748b; }

/* ===== 表单 ===== */
.form-row { margin-bottom: 12rpx; }
.form-row label {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 6rpx;
}
.input, select, textarea, picker {
  display: block;
  width: 100%;
  padding: 14rpx 16rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #1e293b;
  background: #fff;
  box-sizing: border-box;
}
textarea { min-height: 100rpx; }

/* ===== 杂项 ===== */
.muted { color: #64748b; }
.empty {
  color: #94a3b8;
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
}
.row { display: flex; align-items: center; gap: 12rpx; }
.section-title {
  font-weight: 600;
  font-size: 30rpx;
  margin: 24rpx 0 16rpx;
}
.scroll-x {
  overflow-x: auto;
  white-space: nowrap;
}

/* ===== toast ===== */
.toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0,0,0,0.78);
  color: #fff;
  padding: 18rpx 36rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  z-index: 9999;
  opacity: 0;
  transition: opacity 0.3s;
  pointer-events: none;
}
.toast.show { opacity: 1; }

/* ===== 学习记录 ===== */
.log-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-bottom: 20rpx;
}
