page {
  background: #f1f5f9;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #1e293b;
  font-size: 28rpx;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.card-title {
  font-weight: 600;
  font-size: 30rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.btn {
  display: inline-block;
  padding: 10rpx 24rpx;
  border-radius: 10rpx;
  background: #3b82f6;
  color: #fff;
  font-size: 26rpx;
  border: none;
  line-height: 1.4;
}
.btn.ghost {
  background: #eef2ff;
  color: #3b82f6;
}
.btn.outline {
  background: #fff;
  color: #3b82f6;
  border: 1rpx solid #3b82f6;
}
.btn.sm {
  font-size: 22rpx;
  padding: 8rpx 18rpx;
}
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background: #e2e8f0;
  color: #475569;
  margin-right: 8rpx;
}
.badge {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  background: #dcfce7;
  color: #166534;
  margin-left: 8rpx;
}
.muted {
  color: #64748b;
}
.empty {
  color: #94a3b8;
  text-align: center;
  padding: 40rpx 0;
}
.progress-bar {
  height: 12rpx;
  background: #e2e8f0;
  border-radius: 6rpx;
  overflow: hidden;
}
.progress-bar .fill {
  height: 100%;
  background: #3b82f6;
}
.row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.section-title {
  font-weight: 600;
  font-size: 30rpx;
  margin: 24rpx 0 16rpx;
}
.grid-2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}
.grid-3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}
