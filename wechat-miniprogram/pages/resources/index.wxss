.res-block { margin-bottom: 16rpx; }
.res-head { display: flex; justify-content: space-between; align-items: center; background: #fff; padding: 20rpx; border-radius: 12rpx; font-weight: 600; font-size: 28rpx; margin-bottom: 12rpx; }
.res-arrow { color: #64748b; }
.res-card { background: #fff; border-radius: 12rpx; padding: 16rpx; display: flex; flex-direction: column; }
.res-name { font-weight: 600; font-size: 26rpx; margin-bottom: 6rpx; }
.res-desc { font-size: 22rpx; flex: 1; margin-bottom: 10rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.res-link { font-size: 22rpx; color: #3b82f6; }
