<nav-drawer title="学习概览" current="overview">
  <view class="page-header">
    <text class="ph-title">学习概览</text>
    <text class="sub">按月查看学习日历，掌握每日进度</text>
    <view class="ph-actions">
      <button class="btn sm outline" style="margin-right:10rpx" bindtap="prevMonth">◀</button>
      <text style="font-weight:700;font-size:32rpx;margin:0 16rpx">{{monthLabel}}</text>
      <button class="btn sm outline" style="margin-left:10rpx" bindtap="nextMonth">▶</button>
    </view>
  </view>

  <view style="margin-bottom:20rpx">
    <view class="stat-box" style="margin-bottom:14rpx" bindtap="refreshMotivation">
      <view class="label">今日一句</view>
      <view style="font-size:28rpx;line-height:1.6;color:#1e293b;font-style:italic;padding:8rpx 0">{{motivationText}}</view>
      <view wx:if="{{motivationAuthor}}" style="font-size:22rpx;color:#64748b;margin-top:6rpx">{{motivationAuthor}}</view>
    </view>
    <view class="stat-box">
      <view class="label">连续学习</view>
      <view class="value">{{streak}}</view>
      <view class="delta">天</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">
      <text>{{calTitle}}</text>
      <text style="font-weight:400;font-size:24rpx;color:#64748b;display:block;margin-top:4rpx">点选日期查看详情</text>
    </view>
    <table class="calendar-table">
      <thead>
        <tr><th wx:for="{{weekdays}}" wx:key="*this">{{item}}</th></tr>
      </thead>
      <tbody>
        <tr wx:for="{{calRows}}" wx:for-item="row" wx:key="*this">
          <td wx:for="{{row}}" wx:for-item="cell" wx:key="*this"
              style="background:{{cell.bg}};border:{{cell.border}};font-weight:{{cell.fw}};font-size:28rpx"
              bindtap="{{cell.tap ? 'showDayDetail' : ''}}" data-ds="{{cell.ds}}">
            {{cell.day || ''}}
          </td>
        </tr>
      </tbody>
    </table>
  </view>

  <view class="card" wx:if="{{dayDetail}}">
    <view class="card-title">{{dayDetailTitle}}</view>
    <view wx:if="{{dayDetailItems.length}}">
      <view wx:for="{{dayDetailItems}}" wx:key="*this" style="padding:12rpx 0;border-bottom:1rpx solid #f1f5f9;font-size:26rpx">
        <text class="tag {{item.cls}}" style="margin-right:10rpx">{{item.typeName}}</text>
        <text class="muted" style="font-size:22rpx;margin-right:10rpx">{{item.time}}</text>
        <text>{{item.content}}</text>
      </view>
    </view>
    <view wx:else class="empty">当日无记录</view>
  </view>
</nav-drawer>
