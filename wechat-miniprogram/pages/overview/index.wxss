.cal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.cal-nav { font-size: 44rpx; color: #3b82f6; padding: 0 20rpx; }
.cal-title { font-weight: 700; font-size: 30rpx; }
.cal-week { display: flex; }
.cal-grid { display: flex; flex-wrap: wrap; }
.cal-cell { width: 14.28%; box-sizing: border-box; height: 88rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 26rpx; border-radius: 10rpx; }
.cal-w { color: #94a3b8; font-size: 22rpx; height: 56rpx; }
.cal-cell.empty { visibility: hidden; }
.cal-cell.sel { background: #dbeafe; }
.cal-day { font-weight: 600; }
.cal-dot { font-size: 20rpx; color: #3b82f6; background: #dbeafe; border-radius: 20rpx; padding: 0 8rpx; margin-top: 2rpx; }
.log-item { display: flex; gap: 16rpx; padding: 14rpx 0; border-bottom: 1rpx solid #f1f5f9; }
.log-time { font-size: 22rpx; width: 150rpx; flex-shrink: 0; }
.log-text { flex: 1; font-size: 26rpx; }
