.stage-block { margin-bottom: 20rpx; }
.stage-head { background: #fff; padding: 16rpx 20rpx; border-radius: 12rpx; margin-bottom: 12rpx; }
.stage-name { font-weight: 700; font-size: 28rpx; }
.dialog-item { background: #fff; border-radius: 12rpx; padding: 20rpx; margin-bottom: 12rpx; }
.dialog-meta { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.d-scene { font-weight: 600; font-size: 28rpx; }
.d-desc { font-size: 24rpx; margin: 8rpx 0; }
.d-body { background: #f8fafc; border-radius: 10rpx; padding: 16rpx; margin: 10rpx 0; }
.d-line { font-size: 25rpx; margin: 6rpx 0; }
.d-speaker { font-weight: 600; color: #3b82f6; margin-right: 8rpx; }
.d-keywords { font-size: 22rpx; margin: 8rpx 0; }
.d-actions { display: flex; gap: 24rpx; margin-top: 10rpx; }
.link { color: #3b82f6; font-size: 24rpx; }
.badge-new { background: #dbeafe; color: #1d4ed8; font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 8rpx; }
