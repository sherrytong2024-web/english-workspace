<nav-drawer title="对话练习" current="dialogues">
  <!-- 页头 -->
  <view class="page-header">
    <view class="ph-title">对话练习</view>
  <view class="sub">分场景完整对话 · 每日推荐 · 已学对话自动进入复习</view>
  </view>

  <!-- 今日对话卡片 -->
  <view class="card">
    <view class="card-title">
      <text>今日对话（{{dailyDialogs.length}} 段）</text>
      <view class="row" style="gap:6rpx">
        <text style="font-size:22rpx">每天</text>
        <picker mode="selector" range="{{countOptions}}" value="{{ddCountIdx}}" bindchange="onCountChange">
          <view style="width:80rpx;text-align:center;padding:6rpx;border:1rpx solid #e2e8f0;border-radius:6rpx;font-size:24rpx">{{ddCountIdx + 1}}</view>
        </picker>
        <text style="font-size:22rpx">段，类型</text>
        <picker mode="selector" range="{{catSelectNames}}" value="{{ddCatIdx}}" bindchange="onCatChange">
          <view style="width:140rpx;text-align:center;padding:6rpx;border:1rpx solid #e2e8f0;border-radius:6rpx;font-size:24rpx">{{catSelectNames[ddCatIdx]}}</view>
        </picker>
        <button class="btn sm ghost" bindtap="refreshDailyDialogs">换一批</button>
      </view>
    </view>
    <block wx:for="{{dailyDialogs}}" wx:key="id">
      <view class="dialog-item">
        <view class="dialog-meta">
          <text class="tag {{item.catCls}}">{{item.catName}}</text>
          <text style="font-size:24rpx">难度: {{item.level}}</text>
          <text wx:if="{{item.learned}}" class="badge">已学</text>
          <text wx:else class="badge new">今日推荐</text>
          <text class="title">{{item.scene}}</text>
        </view>
        <view class="dialog-body" style="max-height:240rpx;overflow-y:auto">
          <view wx:for="{{item.body}}" wx:for-item="l" wx:key="*this" class="line">
            <text class="speaker">{{l.s}}:</text>{{l.t}}
          </view>
        </view>
        <view class="dialog-actions">
          <button class="btn sm {{item.learned ? 'outline' : ''}}" bindtap="toggleLearned" data-id="{{item.id}}">
            {{item.learned ? '取消已学' : '学完标记'}}
          </button>
        </view>
      </view>
    </block>
    <view wx:if="{{!dailyDialogs.length}}" class="empty">当前分类暂无对话，请调整设置</view>
  </view>

  <!-- 全部对话（按阶段分组） -->
  <view style="margin-bottom:12rpx;font-size:24rpx;color:#64748b">
    全部对话 · {{stages.length}} 个场景 · {{allDialogues.length}} 段
  </view>

  <block wx:for="{{stages}}" wx:for-item="stg" wx:for-index="si" wx:key="name">
    <view class="card" style="border-left:6rpx solid {{stg.color}};padding:20rpx;margin-bottom:20rpx">
      <view class="card-title" style="font-size:28rpx;margin-bottom:14rpx">
        <text>{{si + 1}}. {{stg.name}}</text>
        <text style="font-weight:400;font-size:24rpx;color:#64748b">({{stg.dialogues.length}} 段)</text>
      </view>
      <block wx:for="{{stg.dialogues}}" wx:for-item="d" wx:key="id">
        <view class="dialog-item">
          <view class="dialog-meta">
            <text class="tag {{d.catCls}}">{{d.catName}}</text>
            <text style="font-size:24rpx">难度: {{d.level}}</text>
            <text wx:if="{{d.learned}}" class="badge">已学</text>
            <text wx:else class="badge new">待学</text>
            <text class="title">{{d.scene}}</text>
          </view>
          <view style="font-size:26rpx;color:#64748b;margin-bottom:12rpx">{{d.desc}}</view>
          <view wx:if="{{d.expanded}}" class="dialog-body">
            <view wx:for="{{d.body}}" wx:for-item="l" wx:key="*this" class="line">
              <text class="speaker">{{l.s}}:</text>{{l.t}}
            </view>
          </view>
          <view class="dialog-keywords">
            <text wx:for="{{d.keywords}}" wx:for-item="k" wx:key="*this" class="tag pro">{{k}}</text>
          </view>
          <view class="dialog-actions">
            <button class="btn sm outline" bindtap="toggleDialogBody" data-id="{{d.id}}">{{d.expanded ? '收起对话' : '展开对话'}}</button>
            <button class="btn sm {{d.learned ? 'outline' : ''}}" bindtap="toggleLearned" data-id="{{d.id}}">
              {{d.learned ? '取消已学' : '标记已学'}}
            </button>
            <button class="btn sm ghost" bindtap="copyDialog" data-id="{{d.id}}">复制对话</button>
          </view>
        </view>
      </block>
    </view>
  </block>
</nav-drawer>
