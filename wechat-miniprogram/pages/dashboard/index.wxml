<nav-drawer title="EN Workspace" current="dashboard">
  <view class="page-header">
    <text class="ph-title">{{greeting}}</text>
    <text class="sub">{{todayDate}}</text>
    <view class="ph-actions">
      <button class="btn ghost" bindtap="goRecommend">今日推荐 →</button>
    </view>
  </view>

  <view style="display:flex;flex-wrap:wrap;margin-bottom:20rpx">
    <view class="stat-box" style="width:calc(50% - 7rpx);margin-right:7rpx;margin-bottom:14rpx">
      <view class="label">累计单词</view><view class="value">{{statWords}}</view><view class="delta">本工作台记录</view>
    </view>
    <view class="stat-box" style="width:calc(50% - 7rpx);margin-bottom:14rpx">
      <view class="label">完成对话</view><view class="value">{{statDialogs}}</view><view class="delta">段</view>
    </view>
    <view class="stat-box" style="width:calc(50% - 7rpx);margin-right:7rpx">
      <view class="label">本周学习天数</view><view class="value">{{statDays}}</view><view class="delta">天</view>
    </view>
    <view class="stat-box" style="width:calc(50% - 7rpx)">
      <view class="label">收藏资源</view><view class="value">{{statFavs}}</view><view class="delta">个</view>
    </view>
  </view>

  <view style="display:flex;flex-wrap:wrap;margin-bottom:20rpx">
    <view class="card" style="width:calc(50% - 8rpx);margin-right:8rpx">
      <view class="card-title">本周学习概览</view>
      <view wx:if="{{weeklyActivity.length}}">
        <view wx:for="{{weeklyActivity}}" wx:key="date" style="padding:12rpx 0;border-bottom:1rpx solid #f1f5f9;font-size:26rpx">
          <text style="font-weight:700;color:#3b82f6;margin-right:8rpx">{{item.date}}</text>
          <text>{{item.count}} 项活动</text>
        </view>
      </view>
      <view wx:else class="empty">暂无活动记录</view>
    </view>
    <view class="card" style="width:calc(50% - 8rpx)">
      <view class="card-title">今日推荐</view>
      <view style="padding:12rpx;background:#f8fafc;border-radius:8rpx;margin-bottom:12rpx;font-size:24rpx">
        <text>📅 每日推荐已就绪</text>
      </view>
      <view style="padding:14rpx;background:#f0fdf4;border-radius:10rpx;font-size:26rpx">
        <text style="font-weight:600">今日单词:</text> {{dwDone}}/{{dwTotal}} 已完成
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">学习路径建议（金融硕士求职方向）</view>
    <view style="font-size:26rpx;color:#64748b;line-height:2.2">
      <view>① 词汇层：金融专业核心词 + 日常高频词，每日 15-20 个</view>
      <view>② 听读层：Bloomberg / CNBC 早间播报跟读，建立金融语境</view>
      <view>③ 口语层：金融面试 + 客户对话 + 路演场景模拟</view>
      <view>④ 实战层：每周 2 段完整对话跟读录音，模仿语调</view>
      <view>⑤ 输出层：用英语写一段市场评论，对照 FT/Bloomberg 修正</view>
    </view>
  </view>
</nav-drawer>
