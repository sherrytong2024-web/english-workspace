.filter-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.chip { padding: 8rpx 22rpx; border-radius: 30rpx; background: #e2e8f0; color: #475569; font-size: 24rpx; }
.chip.on { background: #3b82f6; color: #fff; }
.rec-item { display: flex; gap: 16rpx; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid #f1f5f9; }
.rec-thumb { width: 72rpx; height: 72rpx; border-radius: 12rpx; background: linear-gradient(135deg, #3b82f6, #8b5cf6); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 36rpx; flex-shrink: 0; }
.rec-main { flex: 1; min-width: 0; }
.rec-title { font-weight: 600; font-size: 28rpx; }
.rec-meta { font-size: 22rpx; }
.tip { font-size: 22rpx; margin-top: 12rpx; }
