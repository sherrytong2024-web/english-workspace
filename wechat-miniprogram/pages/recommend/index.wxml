<nav-drawer title="每日推荐" current="recommend">
  <view class="card">
    <view class="card-title"><text>📰 今日博客/学习资源</text><button class="btn sm ghost" bindtap="refresh">换一批</button></view>
    <view wx:if="{{loading}}" class="empty">加载中...</view>
    <view wx:elif="{{error}}" class="empty">{{error}}</view>
    <view wx:else>
      <view wx:for="{{blogs}}" wx:key="url" class="rec-item" data-url="{{item.url}}" bindtap="openLink">
        <view class="rec-main">
          <view class="rec-title">{{item.title}}</view>
          <view class="rec-meta muted">{{item.summary}}</view>
          <view class="rec-src">{{item.source}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title"><text>🎵 随机英文歌曲</text></view>
    <view wx:if="{{loading}}" class="empty">加载中...</view>
    <view wx:else>
      <view wx:for="{{songs}}" wx:key="id" class="rec-item" data-url="{{item.preview_url}}" bindtap="playSong">
        <image wx:if="{{item.artwork_url}}" class="rec-thumb-img" src="{{item.artwork_url}}" mode="aspectFill" />
        <view wx:else class="rec-thumb">🎵</view>
        <view class="rec-main">
          <view class="rec-title">{{item.title}}</view>
          <view class="rec-meta muted">{{item.artist}}</view>
        </view>
      </view>
    </view>
  </view>
</nav-drawer>
