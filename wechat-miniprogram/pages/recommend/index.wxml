<nav-drawer title="每日推荐" current="recommend">
  <view class="page-header">
    <view class="ph-title">每日推荐</view>
  <view class="sub">{{recommendDate}}</view>
    <button class="btn" bindtap="refreshRecommend">⟳ 换一批</button>
  </view>

  <view class="section-title">📰 今日博客/学习资源</view>
  <view wx:if="{{blogs.length}}">
    <view wx:for="{{blogs}}" wx:key="url" class="card blog-card">
      <view class="src">{{item.source}}</view>
      <view class="name">{{item.title}}</view>
      <view class="desc">{{item.summary}}</view>
      <text class="link" bindtap="copyLink" data-url="{{item.url}}">阅读全文 →</text>
    </view>
  </view>
  <view wx:else class="empty">暂无文章</view>

  <view class="section-title" style="margin-top:30rpx">🎵 随机英文歌曲</view>
  <view wx:if="{{songs.length}}">
    <view wx:for="{{songs}}" wx:key="id" class="card song-card {{item.liked ? 'liked' : ''}} {{item.disliked ? 'disliked' : ''}}">
      <image wx:if="{{item.artwork_url}}" class="song-art" src="{{item.artwork_url}}" mode="aspectFill"></image>
      <view wx:else class="song-art-placeholder">🎵</view>
      <view class="name" style="font-size:28rpx;margin-top:16rpx">{{item.title}}</view>
      <view class="muted" style="font-size:24rpx">{{item.artist}}</view>
      <block wx:if="{{item.preview_url}}">
        <audio id="audio-{{item.id}}" src="{{item.preview_url}}" style="margin-top:12rpx;width:100%"></audio>
      </block>
      <view wx:else class="song-no-preview">无预览</view>
      <view class="song-actions">
        <button class="btn sm {{item.liked ? '' : 'outline'}}" bindtap="toggleSong" data-id="{{item.id}}" data-type="like">
          {{item.liked ? '❤️ 已喜欢' : '♡ 喜欢'}}
        </button>
        <button class="btn sm {{item.disliked ? 'danger' : 'ghost'}}" bindtap="toggleSong" data-id="{{item.id}}" data-type="dislike">
          {{item.disliked ? '✕ 已跳过' : '跳过'}}
        </button>
      </view>
    </view>
  </view>
  <view wx:else class="empty">暂无歌曲</view>
</nav-drawer>
