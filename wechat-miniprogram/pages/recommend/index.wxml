<nav-drawer title="每日推荐" current="recommend">
  <view class="page-header">
    <text class="ph-title">每日推荐</text>
    <text class="sub">{{recommendDate}}</text>
    <view class="ph-actions">
      <button class="btn" bindtap="refreshRecommend">⟳ 换一批</button>
    </view>
  </view>

  <view class="section-title">📰 今日博客/学习资源</view>
  <view wx:if="{{blogs.length}}">
    <view wx:for="{{blogs}}" wx:key="url" class="card">
      <view style="font-size:22rpx;color:#94a3b8;margin-bottom:4rpx">{{item.source}}</view>
      <view style="font-weight:700;font-size:30rpx;line-height:1.4;margin-bottom:8rpx">{{item.title}}</view>
      <view style="font-size:26rpx;color:#64748b;line-height:1.5;margin-bottom:12rpx">{{item.summary}}</view>
      <text class="link" bindtap="copyLink" data-url="{{item.url}}">阅读全文 →</text>
    </view>
  </view>
  <view wx:else class="empty">暂无文章</view>

  <view class="section-title">🎵 随机英文歌曲</view>
  <view wx:if="{{songs.length}}">
    <view wx:for="{{songs}}" wx:key="id" class="song-card" style="{{item.liked ? 'border:2rpx solid #ef4444' : ''}} {{item.disliked ? 'opacity:0.5' : ''}}">
      <image wx:if="{{item.artwork_url}}" class="song-art" src="{{item.artwork_url}}" mode="aspectFill"></image>
      <view wx:else class="song-art-placeholder">🎵</view>
      <view style="font-weight:600;font-size:28rpx;margin-top:16rpx">{{item.title}}</view>
      <view style="font-size:24rpx;color:#64748b;margin-top:4rpx">{{item.artist}}</view>
      <block wx:if="{{item.preview_url}}">
        <audio id="audio-{{item.id}}" src="{{item.preview_url}}" style="margin-top:12rpx;width:100%"></audio>
      </block>
      <view wx:else style="font-size:22rpx;color:#94a3b8;margin-top:12rpx">无预览</view>
      <view style="text-align:center;margin-top:18rpx">
        <button class="btn sm {{item.liked ? '' : 'outline'}}" style="margin-right:10rpx" bindtap="toggleSong" data-id="{{item.id}}" data-type="like">{{item.liked ? '❤️ 已喜欢' : '♡ 喜欢'}}</button>
        <button class="btn sm {{item.disliked ? 'danger' : 'ghost'}}" bindtap="toggleSong" data-id="{{item.id}}" data-type="dislike">{{item.disliked ? '✕ 已跳过' : '跳过'}}</button>
      </view>
    </view>
  </view>
  <view wx:else class="empty">暂无歌曲</view>
</nav-drawer>
