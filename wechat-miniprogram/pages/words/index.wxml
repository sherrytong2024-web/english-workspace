<nav-drawer title="单词本" current="words">
  <!-- 页头：三段竖排 -->
  <view class="page-header">
    <text class="ph-title">单词本</text>
    <text class="sub">分类管理 · 复习 · 自动记录学习历史</text>
    <view class="ph-actions">
      <button class="btn ghost" bindtap="goReview">开始复习</button>
      <button class="btn" bindtap="showAddForm">+ 添加单词</button>
    </view>
  </view>

  <!-- 今日单词 -->
  <view class="card" wx:if="{{dailyGroups.length}}">
    <view class="card-title">
      <text>今日单词</text>
      <view style="margin-top:10rpx">
        <button class="btn sm ghost" style="margin-right:10rpx;margin-bottom:8rpx" bindtap="logDailyWords">全标记</button>
        <button class="btn sm ghost" style="margin-right:10rpx;margin-bottom:8rpx" bindtap="goReview">去复习</button>
      </view>
    </view>
    <scroll-view scroll-x="true" style="width:100%">
      <block wx:for="{{dailyGroups}}" wx:for-item="group" wx:for-index="gi" wx:key="*this">
        <view wx:if="{{gi > 0}}" style="text-align:center;color:#64748b;font-size:22rpx;padding:12rpx 0">第 {{gi + 1}} 组（10 个）</view>
        <table>
          <thead>
            <tr>
              <th style="width:60rpx">✓</th>
              <th style="min-width:180rpx">单词</th>
              <th style="min-width:200rpx">释义</th>
              <th>分类</th>
              <th style="min-width:300rpx">例句</th>
            </tr>
          </thead>
          <tbody>
            <tr wx:for="{{group}}" wx:for-item="w" wx:key="word">
              <td><checkbox checked="{{w.done}}" bindtap="toggleDailyWord" data-word="{{w.word}}"></checkbox></td>
              <td>
                <text style="font-weight:600;display:block">{{w.word}}</text>
                <text wx:if="{{w.phonetic}}" style="font-size:22rpx;color:#64748b;display:block">{{w.phonetic}}</text>
              </td>
              <td style="word-break:break-all">{{w.meaning}}</td>
              <td><text class="tag {{w.catCls}}">{{w.catName}}</text></td>
              <td style="font-size:24rpx;color:#64748b;max-width:400rpx;word-break:break-all">{{w.example}}</td>
            </tr>
          </tbody>
        </table>
      </block>
    </scroll-view>
    <view class="progress-bar"><view class="fill" style="width:{{dwProgress}}%"></view></view>
    <view style="text-align:center;margin-top:16rpx" wx:if="{{allDailyDone}}">
      <button class="btn" bindtap="addMoreDailyWords">+ 再学 10 个</button>
    </view>
  </view>

  <!-- 分类筛选 -->
  <view class="filter-bar">
    <text wx:for="{{filterCats}}" wx:key="key" class="filter-chip {{item.key === curFilter ? 'active' : ''}}" bindtap="setFilter" data-key="{{item.key}}">{{item.name}}</text>
  </view>

  <!-- 词库表格 -->
  <view class="card">
    <view class="card-title">
      <text>词库 ({{filteredCount}})</text>
      <input class="input" style="width:100%;margin-top:12rpx" placeholder="搜索单词或释义..." bindinput="onSearch" value="{{searchText}}"></input>
    </view>
    <scroll-view scroll-x="true" style="width:100%">
      <table>
        <thead>
          <tr>
            <th style="min-width:180rpx">单词</th>
            <th style="min-width:160rpx">音标</th>
            <th style="min-width:200rpx">释义</th>
            <th>分类</th>
            <th style="min-width:300rpx">例句</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <tr wx:for="{{pagedWords}}" wx:key="word">
            <td>
              <text style="font-weight:600;display:block">{{item.word}}</text>
              <text wx:if="{{item.mastered}}" class="badge">已掌握</text>
            </td>
            <td style="color:#64748b;word-break:break-all">{{item.phonetic}}</td>
            <td style="word-break:break-all">{{item.meaning}}</td>
            <td><text class="tag {{item.catCls}}">{{item.catName}}</text></td>
            <td style="font-size:24rpx;color:#64748b;max-width:400rpx;word-break:break-all">{{item.example}}</td>
            <td>
              <button class="btn sm outline" style="margin-bottom:6rpx;display:block" bindtap="delWord" data-word="{{item.word}}">删除</button>
              <button class="btn sm ghost" bindtap="markMastered" data-word="{{item.word}}">{{item.mastered ? '取消掌握' : '标记掌握'}}</button>
            </td>
          </tr>
          <tr wx:if="{{!pagedWords.length}}">
            <td colspan="6" class="empty">没有匹配的单词</td>
          </tr>
        </tbody>
      </table>
    </scroll-view>
    <view wx:if="{{totalPages > 1}}" style="text-align:center;margin-top:20rpx">
      <button class="btn sm outline" style="margin-right:12rpx" bindtap="goPage" data-p="{{curPage - 1}}" disabled="{{curPage <= 1}}">上一页</button>
      <text class="muted" style="margin:0 16rpx">第 {{curPage}} / {{totalPages}} 页</text>
      <button class="btn sm outline" style="margin-left:12rpx" bindtap="goPage" data-p="{{curPage + 1}}" disabled="{{curPage >= totalPages}}">下一页</button>
    </view>
  </view>

  <!-- 添加新单词表单 -->
  <view class="card" wx:if="{{showAddForm}}">
    <view class="card-title">添加新单词</view>
    <view class="form-row"><view class="form-label">单词</view><input class="input" value="{{newWord.word}}" bindinput="onNewWordField" data-field="word"></input></view>
    <view class="form-row"><view class="form-label">音标 (可选)</view><input class="input" value="{{newWord.phonetic}}" bindinput="onNewWordField" data-field="phonetic" placeholder="/wɜːrd/"></input></view>
    <view class="form-row"><view class="form-label">释义</view><input class="input" value="{{newWord.meaning}}" bindinput="onNewWordField" data-field="meaning"></input></view>
    <view class="form-row">
      <view class="form-label">分类</view>
      <picker mode="selector" range="{{catOptions}}" range-key="name" value="{{newWord.catIdx}}" bindchange="onCatChange">
        <view class="input">{{catOptions[newWord.catIdx].name}}</view>
      </picker>
    </view>
    <view class="form-row"><view class="form-label">例句 (可选)</view><textarea class="input" value="{{newWord.example}}" bindinput="onNewWordField" data-field="example"></textarea></view>
    <view class="form-row"><view class="form-label">备注 (可选)</view><input class="input" value="{{newWord.note}}" bindinput="onNewWordField" data-field="note"></input></view>
    <view style="margin-top:16rpx">
      <button class="btn" style="margin-right:12rpx;margin-bottom:8rpx" bindtap="saveWord">保存</button>
      <button class="btn outline" bindtap="hideAddForm">取消</button>
    </view>
  </view>
</nav-drawer>
